{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snowgym.local/schemas/command-plan.v0.json",
  "title": "SnowGym command plan v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "intentSummary", "groups"],
  "properties": {
    "schemaVersion": { "const": "snowgym.command-plan.v0" },
    "intentSummary": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "allocationWeight", "selection", "order"],
      "properties": {
        "role": { "enum": ["main", "maneuver", "reserve"] },
        "allocationWeight": { "type": "integer", "minimum": 1, "maximum": 10 },
        "selection": {
          "enum": [
            "balanced",
            "frontline",
            "rearline",
            "healthiest",
            "nearest_objective",
            "nearest_left_lane",
            "nearest_right_lane"
          ]
        },
        "order": {
          "anyOf": [
            { "$ref": "#/$defs/engageOrder" },
            { "$ref": "#/$defs/advanceOrder" },
            { "$ref": "#/$defs/holdOrder" },
            { "$ref": "#/$defs/withdrawOrder" },
            { "$ref": "#/$defs/supportOrder" }
          ]
        }
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "fire", "preferredRange", "cohesion"],
      "properties": {
        "posture": { "enum": ["aggressive", "balanced", "conservative"] },
        "fire": { "enum": ["focus", "distributed", "opportunistic"] },
        "preferredRange": { "enum": ["close", "medium", "long"] },
        "cohesion": { "enum": ["tight", "normal", "loose"] }
      }
    },
    "enemyClusterObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "select"],
      "properties": {
        "kind": { "const": "enemy_cluster" },
        "select": { "enum": ["nearest", "largest", "weakest", "leftmost", "rightmost"] }
      }
    },
    "regionObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "region"],
      "properties": {
        "kind": { "const": "region" },
        "region": {
          "enum": ["left_lane", "center_lane", "right_lane", "own_backfield", "enemy_backfield"]
        }
      }
    },
    "currentPositionObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "current_position" } }
    },
    "allyGroupObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role"],
      "properties": {
        "kind": { "const": "ally_group" },
        "role": { "enum": ["main", "maneuver", "reserve"] }
      }
    },
    "engageOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "objective", "approach", "engagement"],
      "properties": {
        "mission": { "const": "engage" },
        "objective": { "$ref": "#/$defs/enemyClusterObjective" },
        "approach": { "enum": ["direct", "left_flank", "right_flank", "avoid_center"] },
        "engagement": { "$ref": "#/$defs/engagement" }
      }
    },
    "advanceOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "objective", "approach", "engagement"],
      "properties": {
        "mission": { "const": "advance" },
        "objective": { "$ref": "#/$defs/regionObjective" },
        "approach": { "enum": ["direct", "left_flank", "right_flank", "avoid_center"] },
        "engagement": { "$ref": "#/$defs/engagement" }
      }
    },
    "holdOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "objective", "approach", "engagement"],
      "properties": {
        "mission": { "const": "hold" },
        "objective": {
          "anyOf": [
            { "$ref": "#/$defs/regionObjective" },
            { "$ref": "#/$defs/currentPositionObjective" }
          ]
        },
        "approach": { "const": "direct" },
        "engagement": { "$ref": "#/$defs/engagement" }
      }
    },
    "withdrawOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "objective", "approach", "engagement"],
      "properties": {
        "mission": { "const": "withdraw" },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "region"],
          "properties": {
            "kind": { "const": "region" },
            "region": { "const": "own_backfield" }
          }
        },
        "approach": { "enum": ["direct", "avoid_center"] },
        "engagement": { "$ref": "#/$defs/engagement" }
      }
    },
    "supportOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission", "objective", "approach", "engagement"],
      "properties": {
        "mission": { "const": "support" },
        "objective": { "$ref": "#/$defs/allyGroupObjective" },
        "approach": { "enum": ["direct", "left_flank", "right_flank", "avoid_center"] },
        "engagement": { "$ref": "#/$defs/engagement" }
      }
    }
  }
}
