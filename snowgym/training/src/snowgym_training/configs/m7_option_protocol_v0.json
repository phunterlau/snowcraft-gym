    "sealedMaps": [500000, 500019]
  },
  "pairedSeedsPerMission": {"development": 40, "qualification": 100},
  "qualification": {
    "missionSuccessMinimum": 0.75,
    "shuffledPlanImprovementMinimum": 0.2,
    "pairedBootstrapLowerBoundMinimum": 0.0,
    "pairedProgressWinFractionMinimum": 0.7,
    "physicalWinRateRetentionTolerance": 0.1,
    "rejectedActionRateMaximum": 0.001,
    "inheritedHeadLearningRateMinimum": 0.00001,
    "newModuleLearningRateMinimum": 0.0001
  }
}
