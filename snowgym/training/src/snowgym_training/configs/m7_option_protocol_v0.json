    "hold": {"horizon": 150, "anchorRadiusDiagonalFraction": 0.08, "requiredDecisionFraction": 0.9, "minimumLivingFraction": 0.5},
    "withdraw": {"horizon": 200, "arrivalRadiusDiagonalFraction": 0.1, "livingMemberFraction": 0.8, "settledDecisions": 20, "minimumLivingFraction": 0.5},
    "flank": {"horizon": 200, "signedLateralExtentFraction": 0.2, "damageWindowDecisions": 50},
    "focus": {"horizon": 200, "meaningfulDamageEnemyHealthFraction": 0.1, "targetDamageHhiMinimum": 0.65},
    "distributed": {"horizon": 200, "meaningfulDamagePerTargetHealthFraction": 0.1, "minimumDamagedTargets": 2, "normalizedTargetDamageEntropyMinimum": 0.65},
    "support": {"horizon": 300, "minimumDistanceDiagonalFraction": 0.08, "maximumDistanceDiagonalFraction": 0.18, "consecutiveDecisions": 30, "minimumLivingFractionPerGroup": 0.5}
  },
  "seeds": {
