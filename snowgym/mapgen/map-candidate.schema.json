{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "snowgym.map-candidate.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "intentSummary", "map"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "snowgym.map-candidate.v0" },
    "intentSummary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height", "objects", "spawns"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "width": { "type": "number", "minimum": 12, "maximum": 120 },
        "height": { "type": "number", "minimum": 12, "maximum": 120 },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "x", "y", "radius"],
                "properties": {
                  "type": { "type": "string", "enum": ["tree", "rock"] },
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "radius": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "x", "y", "width", "height"],
                "properties": {
                  "type": { "type": "string", "enum": ["fort", "fence"] },
                  "x": { "type": "number" },
                  "y": { "type": "number" },
                  "width": { "type": "number", "exclusiveMinimum": 0 },
                  "height": { "type": "number", "exclusiveMinimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "x", "y"],
                "properties": {
                  "type": { "type": "string", "const": "prop" },
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            ]
          }
        },
        "spawns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["team", "x", "y"],
            "properties": {
              "team": { "type": "string", "enum": ["player", "enemy"] },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
